tmp_old/
.DS_Store

# Build output and the Task checksum cache
/build/bin/
/.task/

# Frontend: npm packages, generated bindings, build output (dist keeps a
# .gitkeep from public/ so the Go embed builds without a frontend build)
/frontend/node_modules/
/frontend/bindings/
/frontend/dist/*
!/frontend/dist/.gitkeep

# Local test gateway state and credentials
/.dev/

# Claude Code local settings (machine-specific)
.claude/settings.local.json
